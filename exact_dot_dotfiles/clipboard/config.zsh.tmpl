{{- if eq .chezmoi.os "linux" }}
unalias pbcopy pbpaste 2>/dev/null

pbcopy() {
  if [[ -n "$WAYLAND_DISPLAY" ]] && command -v wl-copy >/dev/null; then
    wl-copy "$@"
  elif [[ -n "$DISPLAY" ]] && command -v xclip >/dev/null; then
    xclip -selection clipboard -in "$@"
  else
    print -u2 'pbcopy requires a Wayland session with wl-clipboard or an X11 session with xclip.'
    return 1
  fi
}

pbpaste() {
  if [[ -n "$WAYLAND_DISPLAY" ]] && command -v wl-paste >/dev/null; then
    wl-paste --no-newline "$@"
  elif [[ -n "$DISPLAY" ]] && command -v xclip >/dev/null; then
    xclip -selection clipboard -out "$@"
  else
    print -u2 'pbpaste requires a Wayland session with wl-clipboard or an X11 session with xclip.'
    return 1
  fi
}
{{- end }}
