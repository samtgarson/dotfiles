#!/usr/bin/env zsh

source ~/.local/share/chezmoi/.helpers

install_brew_app () {
  local app=$1 brew_stderr install_status
  local -a errors

  brew_stderr=$(HOMEBREW_NO_COLOR=1 brew install "$app" -y 2>&1 >&3) 3>&1
  install_status=$?
  errors=(${(M)${(f)brew_stderr}:#Error:*})

  if (( install_status != 0 && ${#errors} == 1 )) &&
    [[ $errors[1] == "Error: $app: It seems there is already an App at '"*".app'." ]]; then
    warn "$app already exists. Skipping install."
    return 0
  fi

  [[ -z $brew_stderr ]] || print -r -- "$brew_stderr" >&2
  return "$install_status"
}

install_apps () {
  local apps=(
    claude-code
    mackup
    pixelsnap
    raycast
    conductor
    tree-sitter-cli
    1password-cli
    {{- if not .minimalinstall }}
    1password
    coreutils
    finicky
    google-chrome
    notion
    postico
    slack
    spotify
    trash
    {{- end }}
  )

  local app
  for app in $apps; do
    successfully install_brew_app "$app"
  done
}

started 'Installing Mac apps'
install_apps
success 'Installed Mac apps'
